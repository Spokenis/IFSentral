<parameter name="content" string="true">#!/usr/bin/env bash
# wait-for-it.sh - Script para aguardar um host:port ficar disponível
# Uso: ./wait-for-it.sh host:port [-t timeout] [-- command args]
# Baseado em: https://github.com/vishnubob/wait-for-it

set -e

TIMEOUT=30
QUIET=0
HOST=""
PORT=""
CMD=""

usage() {
    echo "Uso: $0 host:port [-t timeout] [-- command args]"
    echo "  -t timeout  Timeout em segundos (padrão: $TIMEOUT)"
    echo "  -- command  Comando a executar após a espera"
    exit 1
}

# Parse argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        *:* )
            HOST="${1%%:*}"
            PORT="${1##*:}"
            shift 1
            ;;
        -t)
            TIMEOUT="$2"
            shift 2
            ;;
        -q)
            QUIET=1
            shift 1
            ;;
        --)
            shift
            CMD="$@"
            break
            ;;
        *)
            echo "Argumento desconhecido: $1"
            usage
            ;;
    esac
done

if [[ -z "$HOST" || -z "$PORT" ]]; then
    usage
fi

if [[ $QUIET -eq 0 ]]; then
    echo "Aguardando $HOST:$PORT ficar disponível (timeout: ${TIMEOUT}s)..."
fi

# Tenta conectar até o timeout
start_ts=$(date +%s)
while true; do
    (echo > /dev/tcp/$HOST/$PORT) >/dev/null 2>&1 && break
    
    current_ts=$(date +%s)
    elapsed=$(( current_ts - start_ts ))
    
    if [[ $elapsed -ge $TIMEOUT ]]; then
        echo "Timeout ao aguardar $HOST:$PORT após ${TIMEOUT}s"
        exit 1
    fi
    
    sleep 1
done

if [[ $QUIET -eq 0 ]]; then
    echo "$HOST:$PORT está disponível após ${elapsed}s"
fi

# Executa comando se especificado
if [[ -n "$CMD" ]]; then
    if [[ $QUIET -eq 0 ]]; then
        echo "Executando: $CMD"
    fi
    exec $CMD
fi
</parameter>
