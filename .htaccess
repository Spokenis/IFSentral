##########################################
# IFSentral Lite
##########################################
# Este arquivo é opcional: se o servidor ignorar .htaccess (AllowOverride
# None) ou não tiver mod_rewrite, o site continua funcionando pelo index.php,
# só que com endereços no formato /index.php/login em vez de /login.
#
# Funciona igual na raiz do domínio ou numa subpasta (ex.: /site1/) — não há
# RewriteBase nem caminho fixo para ajustar.
#
# HTTPS: o redirecionamento não é mais feito aqui. Para forçar HTTPS, defina
# FORCE_HTTPS=true na configuração (src/config/env.php).

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Avisa o index.php de que as URLs limpas estão disponíveis
    RewriteRule ^ - [E=IFS_REWRITE:1]

    # Bloqueia acesso direto a código, configuração e arquivos internos.
    # (REDIRECT_STATUS vazio = requisição original do navegador, não uma
    # reescrita interna feita pelas regras abaixo.)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(src|vendor|tests|logs|docs)(/|$) - [F,L]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(bootstrap|system-check|setup-security-tables)\.php$ - [F,L]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule \.(md|json|lock|xml|sql|log|sh)$ - [F,L]

    # Assets estáticos (JS/CSS/imagens) — /assets/... em vez de expor /src/assets/...
    RewriteRule ^assets/(.*)$ src/assets/$1 [L]

    # Todo o resto que não for um arquivo real vai para o index.php, que
    # resolve a rota pela tabela em src/config/routes.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Os cabeçalhos de segurança (CSP, HSTS, X-Frame-Options etc.) são enviados
# pelo PHP em src/core/SecurityHeaders.php, para valerem também quando este
# arquivo é ignorado. Aqui fica só o que cobre os arquivos estáticos.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|svg|png|jpe?g|gif|webp|ico)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
