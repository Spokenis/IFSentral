##########################################
# IFSentral - Security headers and HTTPS
##########################################
# Ensure mod_rewrite and mod_headers are enabled in Apache for these rules to work.

RewriteEngine On

# Respect X-Forwarded-Proto (useful behind proxies/load-balancers)
# Usa a porta HTTPS externa real (HTTPS_PORT, ver docker-compose.yml/
# docker/apache/ifsentral-ssl.conf) em vez de reaproveitar a porta do
# Host: original — HTTP e HTTPS podem estar mapeados a portas diferentes
# no host (ex.: 8080/8443 em ambientes de teste local).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^([^:]+)
RewriteRule ^ https://%1:%{ENV:HTTPS_PORT}%{REQUEST_URI} [L,R=301]

Options -Indexes

##########################################
# URLs limpas — mapeia caminho público (sem pasta/extensão) para o arquivo
# real. Os arquivos continuam nos mesmos lugares (nada de código interno
# muda); só a URL visível ao navegador/dispositivo é que fica limpa. As
# rotas antigas (com /src/... e extensão) continuam servindo os arquivos
# diretamente — não são bloqueadas — mas nada no site as gera mais.
##########################################

# Assets estáticos (JS/CSS/imagens) — /assets/... em vez de expor /src/assets/...
RewriteRule ^assets/(.*)$ src/assets/$1 [L]

# --- Autenticação (pública) ---
RewriteRule ^login$ src/auth/login.html [L]
RewriteRule ^registrar$ src/auth/register.html [L]
RewriteRule ^esqueci-senha$ src/auth/esqueci_senha.html [L]
RewriteRule ^redefinir-senha$ src/auth/redefinir_senha.php [L,QSA]
RewriteRule ^verificar-email$ src/auth/verificar_email.php [L,QSA]
RewriteRule ^api/login$ src/auth/login_api.php [L,QSA]
RewriteRule ^api/logout$ src/auth/logout_api.php [L,QSA]
RewriteRule ^api/cadastrar-usuario$ src/auth/cadastrar_usuario.php [L,QSA]
RewriteRule ^api/esqueci-senha$ src/auth/esqueci_senha.php [L,QSA]
RewriteRule ^api/redefinir-senha$ src/auth/redefinir_senha_api.php [L,QSA]
RewriteRule ^api/verificar-2fa$ src/auth/verificar_2fa_api.php [L,QSA]

