*.pem
*.key
*.crt
secrets/

# Dados sensíveis
data/sensitive/
uploads/private/

# Fotos de perfil enviadas por usuários (dado pessoal, não é código-fonte)
uploads/profile/*
!uploads/profile/.htaccess

