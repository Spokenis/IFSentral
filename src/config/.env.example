# Copie este arquivo para ".env" (mesma pasta) e preencha com as credenciais
# reais do seu servidor. O arquivo ".env" nunca deve ir para o Git.
#
# ATENÇÃO: se o servidor não respeitar o .htaccess, um ".env" dentro da pasta
# do site pode ser baixado por qualquer pessoa. Nesse caso (ou na dúvida) use
# o "env.php" (copie de env.example.php), que não tem esse problema.

# Banco de Dados (MySQL/MariaDB já existente no seu servidor/Hostinger)
# Na Hostinger, DB_HOST normalmente é "localhost"; se não funcionar, use o
# host indicado no painel (ex.: algo como "srv123.hostinger.com").
DB_HOST=localhost
DB_NAME=ifsentral_bd
DB_USER=ifsentral_user
DB_PASS=SUBSTITUA_POR_UMA_SENHA_FORTE_AQUI

# Aplicação
APP_ENV=production
# Endereço público do site, incluindo a subpasta se houver (ex.:
# http://servidor/site1). Vazio = usa o endereço pelo qual o site for acessado.
APP_URL=
ALLOWED_ORIGINS=

# Mude para true SOMENTE se o servidor tiver HTTPS configurado
FORCE_HTTPS=false

# Defina como false para ativar contas de usuário imediatamente sem exigir
# confirmação por e-mail (útil quando não há SMTP configurado)
ENABLE_EMAIL_FEATURES=true

# Sessão (a flag Secure do cookie é ligada sozinha quando o acesso é HTTPS)
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# E-mail / SMTP (ex.: Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=suporte@seudominio.com
SMTP_PASS=SUBSTITUA_PELA_SENHA_DO_E-MAIL
SMTP_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=suporte@seudominio.com
MAIL_FROM_NAME="IFSentral Smart Campus"
